labels = c('stronger peptides', 'opt. peptides', (expression(paste('PWM'[max]))), 'stop codon'))+
t+
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1))->supp_PCAopt_avail
# combine PPI and availability results
