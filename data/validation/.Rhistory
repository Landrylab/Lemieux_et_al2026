drop_na()%>%
ggplot()+
geom_boxplot(aes(x=purpose, y=sticky_score), alpha=0, color ='black', width =0.2)+
geom_jitter(aes(x=purpose, y=sticky_score, color = purpose), width=0.1,  shape=1)+
scale_color_manual(values = c('#C3D37A','#A06AB4','#373737'),
labels = c('stronger peptides', 'opt. peptides', (expression(paste('PWM'[max])))))+
scale_x_discrete(limits = c('reference', 'max PPI', 'PCA opt'),
labels =  c((expression(paste('PWM'[max]))),'stronger peptides', 'opt. peptides'))+
xlab('peptide type')+
ylab('sticky score')+
t+
theme(legend.position = 'none',
axis.text.x = element_text(vjust=0.7, hjust=0.9, angle = 30))#->PCA_opt_vs_stickiness
pca_opt_pep%>%
