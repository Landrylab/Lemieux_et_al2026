peptide_seq<-avail_ppi$D3[4]
pbd_test <-363
family_test<-363
get_PCA_score<-
function(all_single, peptide_seq, pbd_test, family_test){
pep<-unlist(strsplit(peptide_seq, ''))
all_single%>%
dplyr::filter(pbd == pbd_test)->sub_data
score = 0
for (i in 1:length(pep)) {
aa <-pep[i]
sub_data%>%
dplyr::filter(deg == aa & pos == i & family == family_test & paired)%>%
select(med_norm)->aa_score
print(aa)
print(aa_score)
score = score+aa_score
}
score<-unlist(score)
print(score)
return(score)
}
