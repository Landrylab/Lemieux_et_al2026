library(tidyverse)
library(magrittr)
library(ggpubr)
source('~/PL_projects/PL_papers/PPI_optimization_paper/code/functions.R')
setwd('~/PL_projects/PL_papers/PPI_optimization_paper/data/validation/')
pep_val<-read_csv('../peptide_validation.csv')
pep_ref<-read_csv('../pep_reference.csv')
opt_peptide<-
read_csv('condensed_LP_D3_optimized_peptide.csv')[, -1]
ggplot(opt_peptide)+
geom_point(aes(auc, dgr))
# check replication for PPI experiment
opt_peptide%>%
dplyr::filter(D12 %in% c(363, 366, 385))%>%
dplyr::mutate(pair = str_c(D12, '_', D3))%>%
data_summary('auc', 'pair')->summary_opt
df_pair<-as.tibble(matrix(unlist(strsplit(summary_opt$pair, split= '_')), ncol =2, byrow =TRUE))
colnames(df_pair)[1:2]<-c('D12', 'D3')
summary_opt<-
bind_cols(summary_opt, df_pair)
summary_opt%<>%
left_join(opt_peptide[, c('D12', 'D3', 'purpose')],
join_by(D12 == D12, D3==D3))
summary_opt%>%
unique()%>%
ggplot()+
facet_grid(cols = vars(D12), scales='free')+
geom_errorbar(aes(x = D3, y = auc, ymax = auc+sd, ymin = auc-sd))+
geom_point(aes(D3, y=auc, color =purpose))+
xlab('F[3]-peptide')+
ylab('PPI signal\n(mean corrected AUC)')+
scale_color_manual(values = c('#4e67c8ff', 'grey', '#A06AB4','#373737' ),
labels = c('stronger peptides', 'neg. control', 'opt. peptides', (expression(paste('PWM'[max])))))+
t+
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1))->supp_PCAopt_PPI
# import availability for opt peptide and validation peptide
opt_peptide_avail<-
read_csv('condensed_avail_optimized_peptide.csv')[, -1]
avail_validation<-
read_csv('~/PL_projects/growthcurves/validation_Nov2025/condensed_validation_nov2025.csv')
# combine both experiment
colnames(opt_peptide_avail)[4]<-'D3'
bind_rows(opt_peptide_avail, avail_validation)%>%
select(family, D3, purpose, `note sequencing`, auc, dgr)->opt_peptide_avail
opt_peptide_avail[grep(pattern = '*', opt_peptide_avail$D3, fixed = TRUE), 'purpose']<-'stop'
opt_peptide_avail[grep(pattern = '-', opt_peptide_avail$D3, fixed = TRUE), 'purpose']<-'reference'
opt_peptide_avail[is.na(opt_peptide_avail$purpose), 'purpose']<-'max PPI'
opt_peptide_avail$D3<-
gsub('366-1', 'SKVRVFLGWF', opt_peptide_avail$D3)
opt_peptide_avail$D3<-
gsub('363-1', 'SGRFWFSDWL', opt_peptide_avail$D3)
opt_peptide_avail$D3<-
gsub('385-1', 'RRRLHESPWL', opt_peptide_avail$D3)
opt_peptide_avail[grep('^R', opt_peptide_avail$D3), 'family']<-'385'
opt_peptide_avail[grep('^SK', opt_peptide_avail$D3), 'family']<-'366'
opt_peptide_avail[grep('^SG', opt_peptide_avail$D3), 'family']<-'363'
summary_avail<-
data_summary(opt_peptide_avail, 'auc', 'D3')
summary_avail%<>%
left_join(opt_peptide_avail[, c('family', 'D3', 'purpose', 'note sequencing')])%>%
unique()
# check replication for avail experiment
summary_avail%>%
dplyr::filter(family %in% c(363, 366, 385))%>%
dplyr::filter(is.na(`note sequencing`))%>%
#dplyr::filter(purpose !='stop')%>%
