for (i in 1:nrow(pca_opt_pep)) {
peptide_seq<-pca_opt_pep$D3[i]
pbd_test <-as.numeric(pca_opt_pep$D12[i])
family_test<-pca_opt_pep$D12[i]
score_PCA[i]<-
get_PCA_score(all_single, peptide_seq, pbd_test, family_test)
}
View(pca_opt_pep)
