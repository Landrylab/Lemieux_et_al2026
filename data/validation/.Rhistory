lapply(aa_seq, `[[`, 1)
aa_seq <-
strsplit(unlist(aa_seq), '')
for (i in 1:length(aa_seq)) {
if (length(aa_seq[[i]]) == 0){
pca_opt_pep[i, 'sticky_score'] <- 0
next
}
pca_opt_pep[i, 'sticky_score'] <- get_stickyness(aa_seq[[i]], sticky)
}
