colnames(hydrophobicity_c)[2]<-'sticky'
colnames(hydrophobicity_c)[2]<-'sticky_score'
pca_opt_pep[i, 'sticky_score'] <- get_stickyness(aa_seq[[i]], hydrophobicity_c)
for (i in 1:length(aa_seq)) {
if (length(aa_seq[[i]]) == 0){
pca_opt_pep[i, 'sticky_score'] <- 0
next
}
