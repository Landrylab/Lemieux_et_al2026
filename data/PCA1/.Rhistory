scale_alpha_manual(values = c(0.3,1,0.2))+
ylim(-1, 1.2)+
ylab('PCA score')+
xlab('PBD family')+
theme_classic2()+
t+
theme(legend.position = 'bottom',
legend.title = element_blank())+
guides(color = guide_legend(nrow = 1))#->signif_specificity
